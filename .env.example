# Copy this file to .env.local (never commit .env.local):
#   Copy-Item .env.example .env.local
#
# Values below are intentionally blank. Fill them from your own Supabase
# project (Project Settings > API) or from `npm run db:status` for local dev.
# Restart `npm run dev` after changing this file.

# --- Public (sent to the browser) ---------------------------------------
# Local Supabase is normally http://127.0.0.1:54321 (confirm with `npm run db:status`).
NEXT_PUBLIC_SUPABASE_URL=
# The public "anon" / "publishable" key. Safe for the browser ONLY because every table is
# protected by row-level security. Not the service-role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (never prefix with NEXT_PUBLIC_) -----------------------
# REQUIRED to add staff (Phase 2): it is used only to create and disable sign-in accounts.
# It bypasses row-level security: treat it like a root password and never paste it into
# client code, screenshots or chat.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used only for backups/restores (pg_dump).
DATABASE_URL=
